@model string
@{
    var tools = new[]
    {
        new { Key = "hash", Group = "Build & transform", Tone = "tone-1", Title = "Hash generator", Description = "Generate common hashes locally.", Icon = "#", Action = "Hash" },
        new { Key = "formatter", Group = "Build & transform", Tone = "tone-2", Title = "Code formatter", Description = "Format SQL, C#, JSON, XML, HTML, and more.", Icon = "</>", Action = "Formatter" },
        new { Key = "logs", Group = "Observe & operate", Tone = "tone-3", Title = "Logs viewer", Description = "Paste or upload logs for quick analysis.", Icon = "☷", Action = "Logs" },
        new { Key = "system-logs", Group = "Observe & operate", Tone = "tone-4", Title = "System logs", Description = "Index, filter, chart, and inspect log folders.", Icon = "▦", Action = "SystemLogs" },
        new { Key = "system-services", Group = "Observe & operate", Tone = "tone-5", Title = "System Services", Description = "Monitor and control local services and IIS app pools.", Icon = "⚙", Action = "SystemServices" },
        new { Key = "sql-doc", Group = "Database", Tone = "tone-6", Title = "SQL Doc", Description = "Inspect databases, export docs, and draw diagrams.", Icon = "DB", Action = "SqlDoc" }
    };
}

<div class="app-shell no-sidebar">
    <main class="workspace">
        @if (Model == "home")
        {
            <section class="office-home-hero">
                <div class="office-home-mark" aria-hidden="true">DT</div>
                <div><span class="eyebrow">LOCAL-FIRST DEVELOPER UTILITIES</span><h1>Home</h1><p>Choose a focused tool and keep your development workflow moving.</p></div>
            </section>
            @foreach (var group in tools.GroupBy(tool => tool.Group))
            {
                <section class="office-tool-section" aria-labelledby="tool-group-@group.Key.Replace(" ", "-").Replace("&", "and").ToLowerInvariant()">
                    <div class="office-section-heading"><div><h2 id="tool-group-@group.Key.Replace(" ", "-").Replace("&", "and").ToLowerInvariant()">@group.Key</h2><span>Open a utility</span></div></div>
                    <div class="office-tool-grid">
                        @foreach (var tool in group)
                        {
                            <a class="office-tool-tile @tool.Tone" asp-action="@tool.Action">
                                <span class="office-tool-icon" aria-hidden="true">@tool.Icon</span>
                                <span class="office-tool-copy"><strong>@tool.Title</strong><small>@tool.Description</small></span>
                            </a>
                        }
                    </div>
                </section>
            }
        }
        else
        {
            @if (Model != "system-logs")
            {
                var currentTool = tools.First(tool => tool.Key == Model);
                <nav class="tool-breadcrumb" aria-label="Breadcrumb">
                    <ol>
                        <li><a asp-action="Index">Home</a></li>
                        <li aria-current="page">@currentTool.Title</li>
                    </ol>
                </nav>
            }
            @switch (Model)
            {
                case "formatter": <partial name="_FormatterTool" /> break;
                case "logs": <partial name="_LogsTool" /> break;
                case "system-logs": <partial name="_SystemLogsTool" /> break;
                case "system-services": <partial name="_SystemServicesTool" /> break;
                case "sql-doc": <partial name="_SqlDocTool" /> break;
                default: <partial name="_HashTool" /> break;
            }
        }
    </main>
</div>
<div class="toast-container position-fixed bottom-0 end-0 p-3"><div id="app-toast" class="toast" role="status"><div class="toast-body"></div></div></div>

@section Scripts {
    @if (Model != "home")
    {
        <script src="~/js/@(Model)-tool.js" asp-append-version="true"></script>
    }
}
