@model string
@using DevTools.Web.Models
@inject Microsoft.Extensions.Options.IOptions<ToolOptions> ToolConfiguration
@{
    var tools = ToolCatalog.Enabled(ToolConfiguration.Value);
}

<div class="app-shell no-sidebar">
    <main class="workspace">
        @if (Model == "home")
        {
            <div class="home">
                <header class="home-head">
                    <div class="home-head-title">
                        <h1>Tools <span class="home-count" title="Available tools">@tools.Count</span></h1>
                        <p>Logs, services, deployments and database utilities for this server.</p>
                    </div>
                    <label class="home-search">
                        <span class="home-search-icon" aria-hidden="true">⌕</span>
                        <input id="home-search" type="search" placeholder="Search tools…" aria-label="Search tools" autocomplete="off">
                        <kbd aria-hidden="true">/</kbd>
                    </label>
                </header>
                @foreach (var group in tools.GroupBy(tool => tool.Group))
                {
                    <section class="home-group" aria-label="@group.Key">
                        <h2 class="home-group-title">@group.Key</h2>
                        <div class="home-tool-grid">
                            @foreach (var tool in group)
                            {
                                <a class="home-tool @tool.Tone" asp-action="@tool.Action" data-search="@($"{tool.Title} {tool.Description} {string.Join(' ', tool.Features)} {group.Key}".ToLowerInvariant())">
                                    <span class="home-tool-icon" aria-hidden="true">@tool.Icon</span>
                                    <span class="home-tool-body">
                                        <strong>@tool.Title</strong>
                                        <span class="home-tool-desc">@tool.Description</span>
                                        <span class="home-tool-tags">@foreach (var feature in tool.Features) { <span>@feature</span> }</span>
                                    </span>
                                    <span class="home-tool-go" aria-hidden="true">→</span>
                                </a>
                            }
                        </div>
                    </section>
                }
                <p id="home-empty" class="home-empty d-none">No tools match your search.</p>
            </div>
        }
        else
        {
            @if (Model != "system-logs" && Model != "database-compare")
            {
                var currentTool = ToolCatalog.All.First(tool => tool.Key == Model);
                <nav class="tool-breadcrumb" aria-label="Breadcrumb">
                    <ol>
                        <li><a asp-action="Index">Home</a></li>
                        <li aria-current="page">@currentTool.Title</li>
                    </ol>
                </nav>
            }
            @switch (Model)
            {
                case "formatter": <partial name="_FormatterTool" /> break;
                case "logs": <partial name="_LogsTool" /> break;
                case "system-logs": <partial name="_SystemLogsTool" /> break;
                case "system-services": <partial name="_SystemServicesTool" /> break;
                case "sql-doc": <partial name="_SqlDocTool" /> break;
                case "database-compare": <partial name="_DatabaseCompareTool" /> break;
                case "deployment": <partial name="_DeploymentTool" /> break;
                case "patch-management": <partial name="_PatchManagementTool" /> break;
                default: <partial name="_HashTool" /> break;
            }
        }
    </main>
</div>
<div class="toast-container app-toast-container position-fixed top-0 end-0 p-3"><div id="app-toast" class="toast" role="status"><div class="toast-body"></div></div></div>

@section Scripts {
    @if (Model != "home")
    {
        <script src="~/js/@(Model)-tool.js" asp-append-version="true"></script>
    }
    else
    {
        <script src="~/js/home.js" asp-append-version="true"></script>
    }
}
