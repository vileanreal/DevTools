@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="empty-state" role="alert">
    <h1>Something went wrong</h1>
    <p>DevTools could not complete this request. Return home and try again.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Return home</a>
</section>
