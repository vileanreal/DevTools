{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DatabasePaths": {
    "ConfigurationDatabase": "devtools.db",
    "LogIndexDatabase": "devtools-log-index.db"
  },
  "Login": {
    "UseLogin": true
  },
  "Tools": {
    "Hash": false,
    "Formatter": false,
    "Logs": false,
    "SystemLogs": true,
    "SystemServices": true,
    "SqlDoc": true,
    "DatabaseCompare": true,
    "Deployment": true,
    "PatchManagement": true
  },
  "Deployment": {
    "WorkingDirectory": "deployments",
    "MaxUploadMegabytes": 4096,
    "MaxExtractedMegabytes": 20480
  },
  "Hosting": {
    "PathBase": "/DevTools"
  },
  "AllowedHosts": "*"
}
