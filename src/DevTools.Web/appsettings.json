{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DatabasePaths": {
    "ConfigurationDatabase": "devtools.db",
    "LogIndexDatabase": "devtools-log-index.db"
  },
  "Login": {
    "UseLogin": true
  },
  "Tools": {
    "Hash": true,
    "Formatter": true,
    "Logs": true,
    "SystemLogs": true,
    "SystemServices": true,
    "SqlDoc": true
  },
  "Hosting": {
    "PathBase": "/DevTools"
  },
  "AllowedHosts": "*"
}
