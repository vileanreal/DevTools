<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\DevTools.Application\DevTools.Application.csproj" />
    <ProjectReference Include="..\DevTools.Shared\DevTools.Shared.csproj" />
    <!-- Built first so its single .exe can be copied into compiled patches (it targets .NET Framework 4.8, so it is not referenced as an assembly). -->
    <ProjectReference Include="..\DevTools.PatchHelper\DevTools.PatchHelper.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="TargetFramework" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Releases adds this exe (renamed per system) to every compiled patch. -->
    <None Include="..\DevTools.PatchHelper\bin\$(Configuration)\DevTools.PatchHelper.exe" Link="PatchHelper\DevTools.PatchHelper.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.6" />
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.200" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
