<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The .NET publish step adds the ASP.NET Core module handler to this file. -->
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- Allow large Deployment package uploads (IIS caps request bodies at about 30 MB by default).
             4294967295 bytes (about 4 GB) is the IIS maximum; DevTools also enforces Deployment:MaxUploadMegabytes. -->
        <requestLimits maxAllowedContentLength="4294967295" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
